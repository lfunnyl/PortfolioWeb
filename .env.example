# ============================================================
# Firebase Yapılandırması (Firebase Console → Project Settings → Your Apps → Web App)
# ============================================================
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# ============================================================
# Cloud Functions base URL (Firebase deploy sonrası otomatik alınır)
# Format: https://europe-west1-YOUR_PROJECT_ID.cloudfunctions.net
# ============================================================
VITE_FUNCTIONS_BASE=https://europe-west1-your_project_id.cloudfunctions.net

# ============================================================
# Eski Railway backend (artık kullanılmıyor)
# VITE_API_BASE=https://...railway.app
# ============================================================
